{
  "name": "any-exam-easy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "node scripts/local-dev.mjs",
    "dev:next": "node scripts/ensure-dev-cache.mjs && prisma generate && next dev",
    "dev:local": "node scripts/local-dev.mjs",
    "dev:fresh": "npm run clean && node scripts/local-dev.mjs",
    "dev:clean": "DEV_CLEAN=1 node scripts/local-dev.mjs",
    "build": "prisma generate && next build && node scripts/mark-production-build.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "npx prisma migrate deploy",
    "db:rds": "node scripts/setup-rds.mjs",
    "db:sync-questions": "node scripts/sync-question-bank.mjs",
    "db:cleanup-retired-fields": "npx tsx scripts/cleanup-retired-fields.ts",
    "db:verify-questions": "npx tsx scripts/verify-question-bank.ts",
    "db:studio": "prisma studio",
    "db:drizzle:generate": "drizzle-kit generate",
    "db:drizzle:push": "drizzle-kit push",
    "db:drizzle:studio": "drizzle-kit studio",
    "db:seed-user": "node scripts/seed-dev-user.mjs",
    "db:seed-admin": "DEV_USER_ROLE=admin node scripts/seed-dev-user.mjs",
    "db:seed-edtech": "npx tsx scripts/seed-edtech.ts",
    "seed": "npm run db:seed-edtech && npm run db:seed-user",
    "db:export-top300": "node node_modules/tsx/dist/cli.mjs scripts/export-top300-json.mjs",
    "db:expire-trial": "node scripts/expire-user-trial.mjs",
    "test:questions": "tsx scripts/test-question-counts.mjs",
    "anatomy:fetch-vh": "node scripts/fetch-visible-human-organs.mjs",
    "test:sample-questions": "tsx scripts/generate-sample-questions.mts",
    "vercel:setup": "node scripts/vercel-setup.mjs",
    "vercel:db": "node scripts/vercel-database.mjs",
    "vercel:connect-neon": "node scripts/connect-vercel-neon.mjs",
    "vercel:stripe": "node scripts/vercel-stripe-push.mjs --redeploy",
    "db:check": "node scripts/check-db-connection.mjs",
    "aws:setup": "node scripts/aws-setup.mjs",
    "aws:deploy": "node scripts/aws-deploy.mjs",
    "aws:bootstrap": "bash scripts/bootstrap-aws.sh",
    "test": "npm run test:unit && npm run test:component && npm run test:smoke",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:component:watch": "vitest --project component",
    "test:unit:watch": "vitest --project unit",
    "test:a11y": "vitest run --project component tests/unit/a11y",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "test:e2e:headed": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --headed",
    "test:e2e:chromium": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test:all": "npm run test:unit && npm run test:component && npm run test:e2e:chromium",
    "test:qa:questions": "vitest run src/lib/exam-prep/question-seed-qa-gate.test.ts src/lib/exam-prep/usmle-physician-educator-batch-01.test.ts src/lib/exam-prep/usmle-physician-educator-batch-02.test.ts src/lib/exam-prep/naplex-physician-educator-batch-01.test.ts src/lib/exam-prep/mpje-physician-educator-batch-01.test.ts src/lib/exam-prep/nclex-curated-quality.test.ts src/lib/exam-prep/usmle-quality-v2.test.ts",
    "test:qa:usmle": "vitest run src/lib/exam-prep/question-seed-qa-gate.test.ts src/lib/exam-prep/usmle-physician-educator-batch-01.test.ts src/lib/exam-prep/usmle-physician-educator-batch-02.test.ts",
    "test:qa:naplex": "vitest run src/lib/exam-prep/question-seed-qa-gate.test.ts src/lib/exam-prep/naplex-physician-educator-batch-01.test.ts",
    "test:qa:mpje": "vitest run src/lib/exam-prep/question-seed-qa-gate.test.ts src/lib/exam-prep/mpje-physician-educator-batch-01.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:ui": "node scripts/test-ui-buttons.mjs",
    "test:clicks": "node scripts/test-click-audit.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:payments:live": "node scripts/test-payments.mjs --live http://127.0.0.1:3000",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "stripe:free-trial": "node scripts/stripe-free-trial.mjs",
    "stripe:free-trial:deploy": "node scripts/stripe-free-trial.mjs --redeploy",
    "test:smoke:prod": "node scripts/smoke-test.mjs https://any-exam-eas.vercel.app",
    "test:flows": "node scripts/test-feature-flows.mjs",
    "test:flows:prod": "node scripts/test-feature-flows.mjs https://www.anyexameasy.com",
    "email:test-reset": "node scripts/test-reset-email.mjs",
    "email:reset-link": "node node_modules/tsx/dist/cli.mjs scripts/generate-reset-link.mjs",
    "resend:setup": "node scripts/resend-setup.mjs",
    "vercel:email": "node scripts/vercel-email-push.mjs",
    "vercel:email:deploy": "node scripts/vercel-email-push.mjs --redeploy",
    "db:polish-pharmacy": "npx tsx scripts/polish-pharmacy-questions.ts",
    "db:polish-pharmacy:dry": "npx tsx scripts/polish-pharmacy-questions.ts --dry-run",
    "db:polish-pharmacy:all": "npx tsx scripts/polish-pharmacy-questions.ts --all",
    "db:polish-naplex:full": "npm run db:polish-pharmacy && npm run db:qa-gate-naplex-best",
    "db:naplex-best": "node scripts/naplex-best-pipeline.mjs",
    "db:naplex-best:dry": "node scripts/naplex-best-pipeline.mjs --dry-run",
    "db:naplex-best:full": "node scripts/naplex-best-full-pipeline.mjs",
    "db:naplex-best:full:dry": "node scripts/naplex-best-full-pipeline.mjs --dry-run",
    "db:curate-naplex-best:ai": "npx tsx scripts/curate-naplex-best-ai.ts",
    "db:curate-naplex-best:ai:dry": "npx tsx scripts/curate-naplex-best-ai.ts --dry-run --limit 10",
    "db:qa-gate-naplex-best": "npx tsx scripts/qa-gate-naplex-best.ts",
    "db:qa-gate-naplex-best:dry": "npx tsx scripts/qa-gate-naplex-best.ts --dry-run",
    "db:polish-nursing": "npx tsx scripts/polish-nursing-questions.ts",
    "db:polish-nursing:dry": "npx tsx scripts/polish-nursing-questions.ts --dry-run",
    "db:polish-nursing:fix-priority": "npx tsx scripts/polish-nursing-questions.ts --fix-prioritization",
    "db:polish-nursing:fix-priority:dry": "npx tsx scripts/polish-nursing-questions.ts --fix-prioritization --dry-run",
    "db:polish-nursing:all": "npx tsx scripts/polish-nursing-questions.ts --all",
    "db:polish-nursing:pipeline": "npm run db:polish-nursing && npm run db:qa-gate -- --field nursing",
    "db:audit-nclex": "npx tsx scripts/audit-nclex-questions.ts",
    "db:audit-nclex:deep": "npx tsx scripts/audit-nclex-questions.ts --deep",
    "db:audit-nclex:json": "npx tsx scripts/audit-nclex-questions.ts --json",
    "db:curate-nclex": "npx tsx scripts/curate-nclex-questions.ts",
    "db:curate-nclex:dry": "npx tsx scripts/curate-nclex-questions.ts --dry-run --limit 50",
    "db:curate-nclex:ai": "npx tsx scripts/curate-nclex-questions.ts --ai-only --limit 25",
    "db:curate-nclex:batch500": "npx tsx scripts/curate-nclex-questions.ts --editorial --force-ai --limit 500",
    "db:audit-naplex": "npx tsx scripts/audit-naplex-questions.ts",
    "db:audit-naplex:deep": "npx tsx scripts/audit-naplex-questions.ts --deep",
    "db:audit-naplex:json": "npx tsx scripts/audit-naplex-questions.ts --json",
    "db:curate-naplex": "npx tsx scripts/curate-naplex-questions.ts",
    "db:curate-naplex:all": "npx tsx scripts/curate-naplex-questions.ts --all",
    "db:curate-naplex:dry": "npx tsx scripts/curate-naplex-questions.ts --dry-run --limit 50",
    "db:curate-naplex:ai": "npx tsx scripts/curate-naplex-questions.ts --ai-only --limit 25",
    "db:curate-naplex:pipeline": "npm run db:audit-naplex:json && npm run db:curate-naplex:all && npm run db:qa-gate -- --field pharmacy",
    "db:curate-naplex:pipeline:dry": "npm run db:audit-naplex -- --limit 100 && npm run db:curate-naplex:dry && npm run db:qa-gate:dry -- --field pharmacy",
    "db:audit-usmle": "npx tsx scripts/usmle-qa-audit.ts",
    "db:sync-usmle-curated": "npx tsx scripts/sync-usmle-curated-seeds.ts",
    "db:sync-usmle-curated:dry": "npx tsx scripts/sync-usmle-curated-seeds.ts --dry-run",
    "db:polish-usmle": "npx tsx scripts/polish-usmle-questions.ts",
    "db:polish-usmle:dry": "npx tsx scripts/polish-usmle-questions.ts --dry-run",
    "db:polish-usmle:all": "npx tsx scripts/polish-usmle-questions.ts --all",
    "db:polish-usmle:qa-failing": "npx tsx scripts/polish-usmle-qa-failing.ts",
    "db:curate-usmle:ai": "npx tsx scripts/curate-usmle-ai.ts",
    "db:curate-usmle:ai:dry": "npx tsx scripts/curate-usmle-ai.ts --dry-run",
    "db:curate-usmle:ai:all": "npx tsx scripts/curate-usmle-ai.ts --all --max-score 10 --resume",
    "db:qa-gate": "npx tsx scripts/qa-gate-question-bank.ts",
    "db:qa-gate:dry": "npx tsx scripts/qa-gate-question-bank.ts --dry-run",
    "db:qa-full": "node scripts/qa-full-pipeline.mjs",
    "db:qa-physician": "node scripts/qa-physician-pipeline.mjs",
    "db:qa-naplex": "node scripts/qa-naplex-pipeline.mjs",
    "db:qa-naplex:dry": "node scripts/qa-naplex-pipeline.mjs --dry-run",
    "test:load": "node scripts/load-test-concurrent.mjs http://127.0.0.1:3000 20 5",
    "test:load:100": "node scripts/load-test-concurrent.mjs http://127.0.0.1:3000 100 8",
    "test:load:100:prod": "node scripts/load-test-concurrent.mjs https://any-exam-eas.vercel.app 100 20",
    "test:load:k6": "k6 run -e BASE_URL=https://www.anyexameasy.com -e MAX_VUS=4000 -e RAMP_DURATION=5m -e HOLD_DURATION=2m -e RAMP_DOWN=1m -e LOAD_TEST_EMAIL=test-premium@anyexameasy.test -e LOAD_TEST_PASSWORD=TestLogin1! loadtests/k6/main.js",
    "test:load:k6:smoke": "k6 run -e BASE_URL=https://www.anyexameasy.com -e MAX_VUS=10 -e RAMP_DURATION=30s -e HOLD_DURATION=30s -e RAMP_DOWN=15s -e LOAD_TEST_EMAIL=test-premium@anyexameasy.test -e LOAD_TEST_PASSWORD=TestLogin1! loadtests/k6/main.js",
    "test:load:k6:best": "k6 run -e BASE_URL=https://www.anyexameasy.com -e MAX_VUS=100 -e RAMP_DURATION=2m -e HOLD_DURATION=3m -e RAMP_DOWN=1m -e THINK_TIME_MIN=2 -e THINK_TIME_MAX=5 -e LOAD_TEST_EMAIL=test-premium@anyexameasy.test -e LOAD_TEST_PASSWORD=TestLogin1! loadtests/k6/main.js",
    "test:load:k6:local": "k6 run -e BASE_URL=http://127.0.0.1:3000 -e MAX_VUS=50 -e LOAD_TEST_EMAIL=test-premium@anyexameasy.test -e LOAD_TEST_PASSWORD=TestLogin1! loadtests/k6/main.js",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@neondatabase/serverless": "^1.1.0",
