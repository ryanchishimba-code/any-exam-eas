# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string-here

# Database — local: ./scripts/dev.sh (SQLite by default, Docker Postgres if available)
# Vercel: Neon postgresql:// URL in Project → Environment Variables
DATABASE_URL="file:./dev.db"

# OpenAI — exam & learning content generation
OPENAI_API_KEY=

# Web search — Tavily recommended (https://tavily.com)
TAVILY_API_KEY=

# Cron — weekly question-bank sync (Vercel Cron + manual: Authorization: Bearer <secret>)
CRON_SECRET=generate-another-long-random-string

# Stripe — $9/mo subscription with 7-day trial
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
