# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string-here

# Database — REQUIRED on Vercel (Project → Settings → Environment Variables)
# Get a free URL from https://neon.tech — must start with postgresql://
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# OpenAI — exam & learning content generation
OPENAI_API_KEY=

# Web search — Tavily recommended (https://tavily.com)
TAVILY_API_KEY=

# Stripe — $9/mo subscription with 7-day trial
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
