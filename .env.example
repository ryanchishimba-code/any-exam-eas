# App — production: Vercel + Neon (see docs/VERCEL_DATABASE.md)
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string-here

# Database — Neon pooled URL (https://console.neon.tech)
# Local SQLite alternative: file:./dev.db  (run ./scripts/dev.sh)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# OpenAI — exam & learning content generation
OPENAI_API_KEY=

# Web search — Tavily recommended (https://tavily.com)
TAVILY_API_KEY=

# Email — password reset (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Cron — weekly question-bank sync (Vercel Cron + manual: Authorization: Bearer <secret>)
CRON_SECRET=generate-another-long-random-string

# Trial & subscription (in-app trial is separate from Stripe trial on checkout)
TRIAL_DAYS=7
GRACE_PERIOD_DAYS=3
MONTHLY_PRICE_USD=3.99
YEARLY_PRICE_USD=39.99
REQUIRE_EMAIL_VERIFICATION=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Stripe — monthly + optional yearly price
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_YEARLY=
