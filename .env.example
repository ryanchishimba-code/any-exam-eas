# App — production: Vercel + Neon (see docs/VERCEL_DATABASE.md)
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string-here
# Canonical site URL for SEO, Open Graph, sitemap (production: https://www.anyexameasy.com)
# Local dev only. Production uses www.anyexameasy.com automatically (override optional).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database — Neon pooled URL (https://console.neon.tech)
# Copy this file to .env.local for local dev (Next.js loads .env.local automatically).
# Use the *pooler* hostname for serverless (required at ~3k MAU on Vercel)
# Optional: PRISMA_CONNECTION_LIMIT=5
# See docs/NEON_DRIZZLE_SETUP.md for branching, Drizzle, and platform tables.
# Driver: @neondatabase/serverless + drizzle-orm/neon-http (Neon serverless HTTP)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional Clerk (app uses NextAuth by default)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Optional: Vercel Blob for textbook PDFs
# BLOB_READ_WRITE_TOKEN=

# OpenAI — exam & learning content generation
OPENAI_API_KEY=

# Web search — Tavily recommended (https://tavily.com)
TAVILY_API_KEY=

# Email — password reset via Resend (https://resend.com)
# PRODUCTION (Vercel + AWS): all three are required for real delivery to any inbox.
# 1. RESEND_API_KEY — create at resend.com/api-keys
# 2. Verify anyexameasy.com in Resend → Domains
# 3. EMAIL_FROM — must use verified domain (NOT onboarding@resend.dev)
# Without RESEND_API_KEY the API still returns success (anti-enumeration) but no email is sent.
# Check /api/health → checks.passwordResetEmail and server logs [forgot-password] / [email].
# Push to Vercel: add VERCEL_TOKEN below, then npm run vercel:email:deploy (see docs/RESEND_VERCEL.md)
VERCEL_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=Any Exam Easy <noreply@anyexameasy.com>
# Production also set:
# NEXTAUTH_URL=https://www.anyexameasy.com
# NEXT_PUBLIC_SITE_URL=https://www.anyexameasy.com

# Cron — weekly question-bank sync (Vercel Cron + manual: Authorization: Bearer <secret>)
# Also authorizes detailed GET /api/health (checks, env summary, scaleReadiness) for ops monitors.
CRON_SECRET=generate-another-long-random-string

# Analytics — raw event retention after daily rollup (cron purges weekly)
ANALYTICS_RETENTION_DAYS=90
# GA4 measurement ID (optional — enables gtag + hybrid conversion tracking in lib/analytics.ts)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Distributed rate limiting — Upstash Redis (https://console.upstash.com)
# Optional locally; recommended in production for consistent API rate limits across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Trial & subscription — 3-day trial; Pro $34.99/mo (save 5–20% on longer plans)
TRIAL_DAYS=3
TRIAL_LIFETIME_QUESTIONS=150
BASIC_MONTHLY_PRICE_USD=34.99
PRO_MONTHLY_PRICE_USD=34.99
BASIC_YEARLY_PRICE_USD=349.99
PRO_YEARLY_PRICE_USD=349.99
GRACE_PERIOD_DAYS=3
# Legacy compat (maps to Pro monthly if PRO_MONTHLY_PRICE_USD unset)
MONTHLY_PRICE_USD=34.99
# Legacy only — leave empty for standard $0 trial (do NOT set on Vercel for free trial)
TRIAL_INTRO_PRICE_USD=17.99
REQUIRE_EMAIL_VERIFICATION=false

# Google OAuth (optional)
# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Apple Sign In (optional)
APPLE_ID=
APPLE_SECRET=
NEXT_PUBLIC_APPLE_AUTH_ENABLED=

# LinkedIn Sign In (optional) — OpenID Connect app at https://www.linkedin.com/developers
# Authorized redirect URL: <site>/api/auth/callback/linkedin
# Request the "Sign In with LinkedIn using OpenID Connect" product (scopes: openid, profile, email)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
NEXT_PUBLIC_LINKEDIN_AUTH_ENABLED=

# Social / community
# AES key for encrypting brand social tokens at rest (social_accounts). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENC_KEY=
# Outbound publishing/scheduling via Ayrshare (https://www.ayrshare.com)
# One key publishes to all brand channels connected in the Ayrshare dashboard.
# Without it, scheduled posts stay queued (no failures) until you add the key.
AYRSHARE_API_KEY=

# Anatomy — Visible Human reference organs (3D explorer)
# Enabled by default. Cartoon mode organs load from jsDelivr CDN (no download required).
# NEXT_PUBLIC_USE_VISIBLE_HUMAN_ORGANS=0
# CT atlas mode (HuBMAP VH registration, window presets, MPR clip) — on by default:
# NEXT_PUBLIC_ANATOMY_CT_MODE=0
# After npm run anatomy:fetch-vh (recommended for offline CT atlas + faster loads):
# NEXT_PUBLIC_VOLUME_ORGAN_BASE=local
# CT atlas default: tries /anatomy/volumes first, CDN fallback on 404 (no env needed).
# Force CDN only: NEXT_PUBLIC_VOLUME_ORGAN_BASE=cdn

# Stripe — run `npm run stripe:setup` to create all interval prices in test mode
# Enable Apple Pay & Google Pay in Stripe Dashboard → Settings → Payment methods.
# Register your domain for Apple Pay: Dashboard → Settings → Payment method domains
#   (add anyexameasy.com and www.anyexameasy.com for production; localhost for local testing)
# Stripe — run `npm run stripe:setup` to create Basic + Pro prices for all intervals
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Basic tier
STRIPE_BASIC_PRICE_ID_MONTHLY=
STRIPE_BASIC_PRICE_ID_QUARTERLY=
STRIPE_BASIC_PRICE_ID_SEMIANNUAL=
STRIPE_BASIC_PRICE_ID_YEARLY=
# Pro tier
STRIPE_PRO_PRICE_ID_MONTHLY=
STRIPE_PRO_PRICE_ID_QUARTERLY=
STRIPE_PRO_PRICE_ID_SEMIANNUAL=
STRIPE_PRO_PRICE_ID_YEARLY=
# Legacy Pro aliases (optional — used if STRIPE_PRO_* unset)
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_QUARTERLY=
STRIPE_PRICE_ID_SEMIANNUAL=
STRIPE_PRICE_ID_YEARLY=
# Stripe Customer Portal — enable payment method updates + cancellation for Settings recurring billing
# Dashboard → Settings → Billing → Customer portal
# Legacy only — requires ENABLE_LEGACY_INTRO_TRIAL=true AND STRIPE_TRIAL_INTRO_PRICE_ID (leave both unset for $0 trial)
# ENABLE_LEGACY_INTRO_TRIAL=
