# Vercel + Neon — copy to .env for local dev against the same cloud database
# Setup guide: docs/VERCEL_DATABASE.md

NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-dev-secret-at-least-16-characters

# Neon → Connection details → Pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

CRON_SECRET=local-cron-secret-change-in-production

OPENAI_API_KEY=
TAVILY_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

TRIAL_DAYS=7
GRACE_PERIOD_DAYS=3
