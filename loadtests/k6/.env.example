# Target site (default: production)
BASE_URL=https://www.anyexameasy.com

# Load profile
MAX_VUS=4000
RAMP_DURATION=5m
HOLD_DURATION=2m
RAMP_DOWN=1m

# Premium test account (required for questions / AI flows)
LOAD_TEST_EMAIL=test-premium@anyexameasy.test
LOAD_TEST_PASSWORD=TestLogin1!

# Optional — off by default on production
ENABLE_REGISTRATION=false
ENABLE_AI_HEAVY=false

# Think time between steps (seconds)
THINK_TIME_MIN=1
THINK_TIME_MAX=4

# Report output directory
K6_REPORT_DIR=loadtests/k6/reports
