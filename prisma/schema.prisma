generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  dateOfBirth   DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  lessonPlans   LessonPlan[]
  exams         Exam[]
  progress      ProgressRecord[]
  learningQuilts LearningQuilt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  status               String   @default("trialing")
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LessonPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  field       String
  gradeLevel  String?
  subjects    String
  goals       String?
  schedule    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exams       Exam[]
}

model Exam {
  id           String   @id @default(cuid())
  userId       String
  lessonPlanId String?
  title        String
  field        String
  topic        String
  difficulty   String   @default("medium")
  questionCount Int     @default(10)
  content      String
  sources      String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan   LessonPlan? @relation(fields: [lessonPlanId], references: [id])
}

model LearningQuilt {
  id            String   @id @default(cuid())
  userId        String
  title         String
  field         String
  topic         String
  preferredMode String   @default("mixed")
  tiles         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressRecord {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  score      Float?
  completed  Boolean  @default(false)
  metadata   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Stratified MCQ bank (medicine, nursing, pharmacy) — synced from seed sources on a schedule.
model QuestionBankItem {
  id            String   @id @default(cuid())
  fieldId       String
  subjectId     String
  question      String
  options       String
  correctAnswer String
  explanation   String
  solutionSteps String?
  tags          String?
  source        String   @default("seed")
  contentHash   String   @unique
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fieldId, subjectId, active])
}

model QuestionBankSync {
  id           String   @id @default(cuid())
  status       String
  itemsTotal   Int
  itemsCreated Int
  itemsUpdated Int
  itemsSkipped Int
  itemsRetired Int      @default(0)
  errorMessage String?
  finishedAt   DateTime @default(now())
}
