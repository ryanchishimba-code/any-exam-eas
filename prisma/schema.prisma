generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core account for email + password sign-in (see src/lib/user-auth.ts).
model User {
  id            String    @id @default(cuid())
  clerkId       String?   @unique // optional Clerk user id when using Clerk auth
  name          String?
  email         String    @unique // stored lowercase via register/login
  emailVerified DateTime?
  passwordHash  String?   // bcrypt; required for credentials login
  image         String?
  dateOfBirth   DateTime
  lastLoginAt   DateTime?
  lastActiveAt  DateTime?
  role          String    @default("user") // user | support_staff | moderator | admin | super_admin
  accountStatus String    @default("active") // active | suspended | deleted
  mfaEnabled    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  subscription       Subscription?
  lessonPlans        LessonPlan[]
  generatedExams     GeneratedExam[]
  progress           ProgressRecord[]
  learningQuilts     LearningQuilt[]
  userSessions       UserSession[]
  activityLogs       ActivityLog[]
  analyticsEvents    AnalyticsEvent[]
  preferences        UserPreference?
  generationHistory  GenerationHistory[]
  supportNotes       SupportNote[]       @relation("SupportNoteSubject")
  supportNotesAuthored SupportNote[]     @relation("SupportNoteAuthor")
  internalTags       UserInternalTag[]
  bookmarksReceived  UserBookmark[]      @relation("BookmarkedUser")
  bookmarksCreated   UserBookmark[]      @relation("BookmarkEmployee")
  deviceHistory      DeviceHistory[]
  usageMetrics       UserUsageMetrics?
  adminActions       AdminAction[]       @relation("AdminActionActor")
  feedbackSubmissions UserFeedback[]
  feedbackResolved   UserFeedback[]      @relation("FeedbackResolvedBy")
  questionReports    QuestionReport[]
  questionReportsApplied QuestionReport[] @relation("QuestionReportAppliedBy")
  questionReportsResolved QuestionReport[] @relation("QuestionReportResolvedBy")
  studySessions      StudySession[]
  questionAttempts   QuestionAttempt[]
  learningProfile    LearningProfile?
  conceptMasteries   ConceptMastery[]
  questionMasteries  QuestionMastery[]
  drugReviewCycles   DrugReviewCycle[]
  drugCardProgress   DrugCardProgress[]
  memoryCardMastery  MemoryCardMastery[]
  promoRedemptions   PromoRedemption[]
  examSessions       ExamSession[]
  generatedQuestions GeneratedQuestion[]
  flashcards         Flashcard[]
  textbookUploads    TextbookUpload[]
  passwordResetTokens PasswordResetToken[]
  examPreference     UserExamPreference?
  topicProgress      UserTopicProgress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time tokens for forgot-password flow (SHA-256 hash at rest — never store raw token).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

/// Discount codes — validated at signup; registration always proceeds.
model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  discountPercent  Int?
  discountAmount   Float?
  expiryDate       DateTime?
  maxUses          Int?
  currentUses      Int       @default(0)
  stripeCouponId   String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  redemptions      PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  createdAt   DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
}

/// Timed practice exams with real-time answer persistence (distinct from StudySession).
model ExamSession {
  id              String    @id @default(cuid())
  userId          String
  examType        String    // nclex | usmle | naplex | top500
  fieldId         String?
  title           String?
  status          String    @default("in_progress") // in_progress | completed | abandoned
  score           Float?
  weakAreas       Json?
  answers         Json      @default("[]")
  analysis        Json?
  questionCount   Int       @default(0)
  timeLimitSec    Int?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examType, createdAt])
  @@map("exam_sessions")
}

/// AI-generated questions (user-specific or shared).
model GeneratedQuestion {
  id            String   @id @default(cuid())
  userId        String
  examType      String
  topic         String?
  questionText  String   @db.Text
  options       Json
  answer        String   @db.Text
  explanation   String   @db.Text
  source        String?  // topic | textbook | weak_areas
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examType, createdAt])
  @@map("generated_questions")
}

/// Spaced-repetition flashcards (FSRS-inspired).
model Flashcard {
  id          String    @id @default(cuid())
  userId      String
  examType    String
  front       String    @db.Text
  back        String    @db.Text
  topic       String?
  dueDate     DateTime  @default(now())
  interval    Float     @default(0)
  easeFactor  Float     @default(2.5)
  repetitions Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examType, dueDate])
  @@map("flashcards")
}

/// Official blueprint topics per exam hub.
model ExamTopic {
  id          String   @id @default(cuid())
  examType    String
  slug        String
  label       String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  parentSlug  String?
  createdAt   DateTime @default(now())

  @@unique([examType, slug])
  @@index([examType, sortOrder])
  @@map("exam_topics")
}

/// Uploaded textbook PDF metadata (blob in Vercel Blob / S3).
model TextbookUpload {
  id          String   @id @default(cuid())
  userId      String
  examType    String?
  title       String
  blobUrl     String
  mimeType    String   @default("application/pdf")
  pageCount   Int?
  chunkCount  Int      @default(0)
  status      String   @default("processing") // processing | ready | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("textbook_uploads")
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  status               String   @default("trialing")
  plan                 String?  // trial | subscribe
  planTier             String   @default("pro") // basic | pro
  planInterval         String   @default("yearly") // monthly | quarterly | semiannual | yearly
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  gracePeriodEndsAt    DateTime?
  /** Dedupes trial-ending reminder emails — stores the trialEndsAt we reminded for. */
  trialReminderForEndsAt DateTime?
  /** Dedupes pre-renewal reminder emails — stores the currentPeriodEnd we reminded for. */
  billingReminderForPeriodEnd DateTime?
  compAccessUntil      DateTime? // admin-granted complimentary access
  canceledAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One free trial per email (prevents re-signup abuse).
model TrialEligibility {
  email     String   @id
  usedAt    DateTime @default(now())
  userId    String?
}

model LessonPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  field       String
  gradeLevel  String?
  subjects    String
  goals       String?
  schedule    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedExams GeneratedExam[]
}

/// AI-generated practice exam saved by a user (legacy lesson-plan flow).
model GeneratedExam {
  id           String   @id @default(cuid())
  userId       String
  lessonPlanId String?
  title        String
  field        String
  topic        String
  difficulty   String   @default("medium")
  questionCount Int     @default(10)
  content      String
  sources      String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan   LessonPlan? @relation(fields: [lessonPlanId], references: [id])

  @@map("Exam")
}

model LearningQuilt {
  id            String   @id @default(cuid())
  userId        String
  title         String
  field         String
  topic         String
  preferredMode String   @default("mixed")
  tiles         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressRecord {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  score      Float?
  completed  Boolean  @default(false)
  metadata   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Stratified exam bank (medicine, nursing, pharmacy, MPJE) — synced from seed sources on a schedule.
model QuestionBankItem {
  id              String   @id @default(cuid())
  fieldId         String
  subjectId       String
  /// Two-letter state code for state-specific MPJE items; NULL = federal/uniform.
  stateCode       String?  @db.Char(2)
  /// 1 (easiest) – 5 (hardest); aligns with adaptive engine weighting.
  difficulty      Int?     @db.SmallInt
  /// High-level topic slug (e.g. controlled-substances, med-surg).
  topicCategory   String?
  /// Exam blueprint domain (NAPLEX 2025, NCLEX-NGN, USMLE, MPJE/UMPJE).
  blueprintDomain String?
  /// NCCPA PANCE task category slug (history-physical, diagnosis, pharmacotherapy, …).
  taskCategory    String?
  /// Specific blueprint high-yield topic (e.g. ACS, sepsis) for Deep Dive / analytics.
  blueprintTopic  String?
  /// AANP FNP patient lifespan band (newborn, infant, toddler, child, adolescent, young-adult, middle-adult, older-adult).
  patientAgeGroup String?
  /// AI model + pipeline version (e.g. gpt-4o-mini-pance-v1).
  generationVersion String?
  /// Editorial review: pending | approved | flagged | rejected.
  reviewStatus    String?
  lastReviewedAt  DateTime?
  /// Batch id, QC scores, seed refs, blueprint alignment notes (JSON).
  generationMeta  Json?
  /// mcq | vignette | sequential | abstract | drug_ad | ethics | biostats | ccs_prompt | exhibit | …
  itemType        String   @default("mcq")
  /// step1 | step2 | step3 for USMLE items
  stepLevel       String?
  /// Optional clinical/operational vignette displayed above the stem (MPJE scenarios).
  scenario        String?
  question        String
  options         String
  correctAnswer   String
  explanation     String
  solutionSteps   String?
  tags            String?
  /// Cited sources / references for rationales (JSON array).
  references      Json?
  source          String   @default("seed")
  contentHash     String   @unique
  active          Boolean  @default(true)
  /// Set by scripts/qa-gate-question-bank.ts — only qaPassed items are served in practice.
  qaPassed        Boolean  @default(false)
  qaAuditedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fieldId, subjectId, active, qaPassed])
  @@index([fieldId, active, qaPassed])
  @@index([fieldId, stateCode, active])
  @@index([fieldId, difficulty, active])
  @@index([fieldId, topicCategory, active])
  @@index([fieldId, blueprintDomain, active])
  @@index([fieldId, taskCategory, active])
  @@index([fieldId, reviewStatus, active])
  @@index([fieldId, blueprintTopic, active])
  @@index([fieldId, itemType, active])
  @@index([fieldId, stepLevel, active])
  @@index([fieldId, patientAgeGroup, active])
  @@index([fieldId, blueprintDomain, patientAgeGroup, active])
  naplexFullExamLinks NaplexFullPracticeExamQuestion[]
  usmleFullExamLinks  UsmleFullPracticeExamQuestion[]
  nclexFullExamLinks  NclexFullPracticeExamQuestion[]
}

/// Curated NAPLEX full-length practice exams (2026 blueprint, 75–85 questions each).
model NaplexFullPracticeExam {
  id                String   @id @default(cuid())
  examNumber        Int      @unique
  title             String
  questionCount     Int
  blueprintSummary  Json?
  formatSummary     Json?
  batchId           String?
  generationVersion String?
  qaPassed          Boolean  @default(false)
  qaReport          Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  questions         NaplexFullPracticeExamQuestion[]

  @@index([active, examNumber])
  @@map("naplex_full_practice_exams")
}

/// Ordered question membership for a NAPLEX full-length practice exam.
model NaplexFullPracticeExamQuestion {
  id                 String   @id @default(cuid())
  examId             String
  questionBankItemId String
  sortOrder          Int
  blueprintArea      String?
  itemFormat         String?
  createdAt          DateTime @default(now())
  exam               NaplexFullPracticeExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question           QuestionBankItem       @relation(fields: [questionBankItemId], references: [id], onDelete: Cascade)

  @@unique([examId, sortOrder])
  @@unique([examId, questionBankItemId])
  @@index([examId])
  @@index([questionBankItemId])
  @@map("naplex_full_practice_exam_questions")
}

/// Curated USMLE full-length block-style practice exams (2026 blueprint, 75–85 questions each).
model UsmleFullPracticeExam {
  id                String   @id @default(cuid())
  examNumber        Int      @unique
  title             String
  stepLevel         String   // step1 | step2
  questionCount     Int
  blueprintSummary  Json?
  formatSummary     Json?
  taskSummary       Json?
  batchId           String?
  generationVersion String?
  qaPassed          Boolean  @default(false)
  qaReport          Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  questions         UsmleFullPracticeExamQuestion[]

  @@index([active, examNumber])
  @@index([stepLevel, active])
  @@map("usmle_full_practice_exams")
}

/// Ordered question membership for a USMLE full-length practice exam.
model UsmleFullPracticeExamQuestion {
  id                 String   @id @default(cuid())
  examId             String
  questionBankItemId String
  sortOrder          Int
  blueprintSystem    String?
  physicianTask      String?
  itemFormat         String?
  createdAt          DateTime @default(now())
  exam               UsmleFullPracticeExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question           QuestionBankItem       @relation(fields: [questionBankItemId], references: [id], onDelete: Cascade)

  @@unique([examId, sortOrder])
  @@unique([examId, questionBankItemId])
  @@index([examId])
  @@index([questionBankItemId])
  @@map("usmle_full_practice_exam_questions")
}

/// Curated NCLEX-RN full-length practice exams (2026 blueprint, 75–85 questions each).
model NclexFullPracticeExam {
  id                String   @id @default(cuid())
  examNumber        Int      @unique
  title             String
  questionCount     Int
  blueprintSummary  Json?
  caseStudySummary  Json?
  batchId           String?
  generationVersion String?
  qaPassed          Boolean  @default(false)
  qaReport          Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  questions         NclexFullPracticeExamQuestion[]

  @@index([active, examNumber])
  @@map("nclex_full_practice_exams")
}

/// Ordered question membership for an NCLEX full-length practice exam.
model NclexFullPracticeExamQuestion {
  id                  String   @id @default(cuid())
  examId              String
  questionBankItemId  String
  sortOrder           Int
  clientNeedsCategory String?
  itemFormat          String?
  createdAt           DateTime @default(now())
  exam                NclexFullPracticeExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question            QuestionBankItem       @relation(fields: [questionBankItemId], references: [id], onDelete: Cascade)

  @@unique([examId, sortOrder])
  @@unique([examId, questionBankItemId])
  @@index([examId])
  @@index([questionBankItemId])
  @@map("nclex_full_practice_exam_questions")
}

/// Official AANPCB FNP blueprint domains, age groups, and clinical systems.
model AanpFnpBlueprintCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  kind        String
  label       String
  weight      Float
  sortOrder   Int      @default(0)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([kind, sortOrder])
  @@map("aanp_fnp_blueprint_categories")
}

/// High-yield AANP FNP topics linked to blueprint domains and question-bank subjects.
model AanpFnpTopic {
  id           String   @id @default(cuid())
  slug         String   @unique
  label        String
  categorySlug String?
  domainSlug   String?
  subjectId    String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([domainSlug, sortOrder])
  @@index([subjectId])
  @@map("aanp_fnp_topics")
}

/// NCCPA PANCE 2025 blueprint — medical content categories + task areas.
model PanceBlueprintCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  kind        String
  label       String
  weight      Float
  sortOrder   Int      @default(0)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([kind, sortOrder])
  @@map("pance_blueprint_categories")
}

/// High-yield PANCE topics — links content + task dimensions to Deep Dive modules.
model PanceTopic {
  id               String   @id @default(cuid())
  slug             String   @unique
  label            String
  contentCategory  String?
  taskCategory     String?
  subjectId        String?
  reviewModuleSlug String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([contentCategory, sortOrder])
  @@index([subjectId])
  @@map("pance_topics")
}

/// FSBPT NPTE-PT 2024 blueprint — body systems + non-system content areas.
model NptePtBlueprintCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  kind        String
  label       String
  weight      Float
  sortOrder   Int      @default(0)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([kind, sortOrder])
  @@map("npte_pt_blueprint_categories")
}

/// High-yield NPTE-PT topics linked to blueprint categories and Deep Dive modules.
model NptePtTopic {
  id               String   @id @default(cuid())
  slug             String   @unique
  label            String
  contentCategory  String?
  taskCategory     String?
  subjectId        String?
  reviewModuleSlug String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([contentCategory, sortOrder])
  @@index([subjectId])
  @@map("npte_pt_topics")
}

model QuestionBankSync {
  id           String   @id @default(cuid())
  status       String
  itemsTotal   Int
  itemsCreated Int
  itemsUpdated Int
  itemsSkipped Int
  itemsRetired Int      @default(0)
  errorMessage String?
  finishedAt   DateTime @default(now())
}

// --- Analytics & internal CRM (event-driven, staff-only UI at /internal) ---

/// Extended session telemetry (beyond NextAuth Session).
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  browser    String?
  os         String?
  deviceType String?
  ipHash     String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([lastSeenAt])
}

model DeviceHistory {
  id          String   @id @default(cuid())
  userId      String
  userAgent   String?
  browser     String?
  os          String?
  deviceType  String?
  ipHash      String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

/// Append-only event store for analytics at scale.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  eventType  String
  category   String   @default("general")
  metadata   String?
  ipHash     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([createdAt])
}

/// Pre-aggregated metrics (cron / on-demand rollup).
model AnalyticsDailySummary {
  id          String   @id @default(cuid())
  date        String
  metricKey   String
  metricValue Float
  dimensions  String?
  createdAt   DateTime @default(now())

  @@unique([date, metricKey, dimensions])
  @@index([date, metricKey])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  summary   String
  metadata  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model GenerationHistory {
  id            String   @id @default(cuid())
  userId        String
  examId        String?  @unique
  quiltId       String?
  field         String
  subjectId     String?
  topic         String
  difficulty    String   @default("medium")
  questionCount Int      @default(0)
  status        String   @default("success")
  durationMs    Int?
  errorMessage  String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([field, createdAt])
  @@index([subjectId, createdAt])
}

model UserPreference {
  userId            String   @id
  preferredFields   String?
  defaultDifficulty String?
  metadata          String?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserUsageMetrics {
  userId              String    @id
  generationCount     Int       @default(0)
  examCount           Int       @default(0)
  quiltCount          Int       @default(0)
  loginCount          Int       @default(0)
  lastGenerationAt    DateTime?
  totalSessionSeconds Int       @default(0)
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("SupportNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  author    User     @relation("SupportNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserInternalTag {
  id          String   @id @default(cuid())
  userId      String
  tag         String
  createdById String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([tag])
}

model UserBookmark {
  id         String   @id @default(cuid())
  employeeId String
  userId     String
  note       String?
  createdAt  DateTime @default(now())
  employee   User     @relation("BookmarkEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  user       User     @relation("BookmarkedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([employeeId, userId])
}

/// Audit trail for employee/admin actions (including CRM views).
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/// User-submitted product feedback (public form + staff inbox).
model UserFeedback {
  id           String    @id @default(cuid())
  name         String?
  email        String?
  category     String
  message      String
  rating       Int
  status       String    @default("open") // open | resolved
  userId       String?
  ipHash       String?
  userAgent    String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy   User?     @relation("FeedbackResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([category, createdAt])
  @@index([status, createdAt])
  @@index([rating])
  @@index([createdAt])
}

/// Per-question study attempts for analytics and adaptive review.
model QuestionAttempt {
  id                  String   @id @default(cuid())
  userId              String
  questionKey         String
  bankItemId          String?
  fieldId             String
  subjectId           String?
  questionType        String   @default("multiple_choice")
  stemPreview         String?
  correct             Boolean
  confidence          Int?
  durationMs          Int?
  selectedAnswer      String?
  sessionId           String?
  tagsJson            String?
  mistakeCategory     String?
  guessedCorrect      Boolean  @default(false)
  difficultyAtAttempt String?
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fieldId, createdAt])
  @@index([userId, correct, createdAt])
  @@index([questionKey, correct])
  @@index([bankItemId])
  @@index([userId, mistakeCategory])
}

/// User-reported problematic questions — triaged by staff with automated QA analysis.
model QuestionReport {
  id                    String    @id @default(cuid())
  userId                String?
  bankItemId            String?
  questionKey           String
  fieldId               String
  examSlug              String?
  subjectId             String?
  sessionId             String?
  sessionMode           String?
  reason                String
  message               String?
  selectedAnswer        String?
  status                String    @default("open") // open | applied | resolved | dismissed
  stemPreview           String?
  optionsSnapshot       String?
  correctAnswerSnapshot String?
  analysisStatus        String    @default("pending") // pending | complete | failed
  issueSummary          String?
  issueCodes            String?
  systemIssues          String?
  proposedFix           String?
  generationNotes       String?
  appliedAt             DateTime?
  appliedById           String?
  resolvedAt            DateTime?
  resolvedById          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  appliedBy             User?     @relation("QuestionReportAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  resolvedBy            User?     @relation("QuestionReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([fieldId, createdAt])
  @@index([examSlug, createdAt])
  @@index([bankItemId])
  @@index([analysisStatus, createdAt])
}

/// Aggregated learner state — readiness, streaks, AI-ready metadata blob.
model LearningProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  readinessScore  Float    @default(0)
  studyStreakDays Int      @default(0)
  lastStudiedAt   DateTime?
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Per-concept mastery (tag or subject topic) for adaptive routing.
model ConceptMastery {
  id                    String   @id @default(cuid())
  userId                String
  fieldId               String
  conceptKey            String
  masteryScore          Float    @default(0)
  retentionStrength     Float    @default(0)
  confidenceReliability Float    @default(0)
  attempts              Int      @default(0)
  correct               Int      @default(0)
  lastAttemptAt         DateTime?
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fieldId, conceptKey])
  @@index([userId, fieldId, masteryScore])
}

/// Per-question spaced repetition + ability estimate for adaptive selection.
model QuestionMastery {
  id              String    @id @default(cuid())
  userId          String
  questionKey     String
  fieldId         String
  easeFactor      Float     @default(2.5)
  intervalDays    Int       @default(0)
  repetitions     Int       @default(0)
  nextDue         DateTime  @default(now())
  abilityEstimate Float     @default(0.5)
  lastAttemptAt   DateTime?
  correctStreak   Int       @default(0)
  yieldScore      Float     @default(0.5)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId, fieldId, nextDue])
  @@index([userId, nextDue])
}

/// Persisted study session state (resume across devices when synced).
model StudySession {
  id         String   @id @default(cuid())
  userId     String
  sourceType String
  sourceId   String?
  fieldId    String
  subjectId  String?
  mode       String   @default("practice")
  stateJson  String
  completed  Boolean  @default(false)
  score      Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, completed])
}

/// Quarterly Top 300 Drugs review cycle (resets every 3 months).
model DrugReviewCycle {
  id           String   @id @default(cuid())
  userId       String
  cycleKey     String
  startedAt    DateTime @default(now())
  endsAt       DateTime
  drugsTotal   Int      @default(300)
  cardsReviewed Int     @default(0)
  cardsMastered Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleKey])
  @@index([userId, endsAt])
}

/// Per-drug spaced-repetition state within a quarterly cycle.
model DrugCardProgress {
  id              String    @id @default(cuid())
  userId          String
  cycleKey        String
  drugId          String
  generic         String
  brand           String
  indication      String
  repetitions     Int       @default(0)
  easeFactor      Float     @default(2.5)
  intervalDays    Float     @default(0)
  nextReviewAt    DateTime  @default(now())
  lastReviewAt    DateTime?
  lastGrade       Int?
  lapseCount      Int       @default(0)
  mastered        Boolean   @default(false)
  mnemonic        String?
  mnemonicAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleKey, drugId])
  @@index([userId, cycleKey, nextReviewAt])
  @@index([userId, cycleKey, mastered])
}

/// Per-memory-card mastery (got-it / need-review) for Reference Hub spaced study.
model MemoryCardMastery {
  id        String   @id @default(cuid())
  userId    String
  examSlug  String
  cardId    String
  status    String   // got-it | need-review
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examSlug, cardId])
  @@index([userId, examSlug, status])
  @@index([userId, examSlug, updatedAt])
}

/// Canonical Top 300 drug catalog (seeded from JSON; source of truth for flashcards).
model Top300Drug {
  id              String   @id
  rank            Int      @unique
  generic         String
  brand           String
  drugClass       String   /// pharmacologic/therapeutic class (JSON: `class`)
  indications     String   @db.Text
  sideEffects     String   @db.Text
  mnemonic        String   @db.Text
  examNclex       Boolean  @default(true)
  examUsmle       Boolean  @default(true)
  examNaplex      Boolean  @default(true)
  category        String?  /// study bucket: cardiovascular, antibiotics, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([examNclex])
  @@index([examUsmle])
  @@index([examNaplex])
}

/// Static reference for the four core board exams (NCLEX, USMLE, NAPLEX, MPJE).
model BoardExam {
  slug                    String   @id
  name                    String
  shortName               String
  fieldId                 String
  description             String
  simulatedDurationMin    Int
  simulatedQuestionCount  Int
  createdAt               DateTime @default(now())
  preferences             UserExamPreference[]
  highYieldTopics         HighYieldTopic[]

  @@map("BoardExam")
}

/// User's primary exam selection — drives Study Hub personalization.
model UserExamPreference {
  userId        String    @id
  examSlug      String
  lastStudiedAt DateTime?
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam          BoardExam @relation(fields: [examSlug], references: [slug], onDelete: Restrict)
}

/// Exam-specific high-yield topic summaries (book-summary style study cards).
model HighYieldTopic {
  id                String   @id
  examSlug          String
  slug              String
  category          String
  title             String
  overview          String
  summary           String   @default("")
  keyConcepts       Json
  mustKnowFacts     Json
  pearls            Json
  pitfalls          Json
  reviewModule      Json?
  sortOrder         Int      @default(0)
  practiceTopicSlug String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  exam              BoardExam @relation(fields: [examSlug], references: [slug], onDelete: Cascade)
  userProgress      UserTopicProgress[]

  @@unique([examSlug, slug])
  @@index([examSlug, sortOrder])
  @@index([examSlug, category])
}

/// Tracks topic views and practice launches per user.
model UserTopicProgress {
  id            String    @id @default(cuid())
  userId        String
  topicId       String
  lastViewedAt  DateTime?
  reviewCount   Int       @default(0)
  practiceCount Int       @default(0)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic         HighYieldTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}
