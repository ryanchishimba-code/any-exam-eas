# AWS ECS / RDS production — use Secrets Manager in real deploys
# Local testing against RDS: copy to .env

NODE_ENV=production
NEXTAUTH_URL=https://app.yourdomain.com
NEXTAUTH_SECRET=from-aws-setup-script
CRON_SECRET=from-aws-setup-script

DATABASE_URL=postgresql://USER:PASSWORD@your-rds.region.rds.amazonaws.com:5432/anyexameasy?sslmode=require

# First ECS deploy only (then set false)
RUN_MIGRATIONS=true

OPENAI_API_KEY=
TAVILY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
