{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/db-keepalive",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-question-bank",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/billing-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/analytics-rollup",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/analytics-retention",
      "schedule": "0 7 * * 0"
    },
    {
      "path": "/api/cron/social-publish",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "src/app/api/questions/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/sync-question-bank/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/analytics-retention/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/full-exam/start/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ai/generate/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/generate-test/route.ts": {
      "maxDuration": 120
    }
  }
}
